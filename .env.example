# Origin сайта (без слэша в конце) — для canonical, sitemap, Open Graph
NEXT_PUBLIC_SITE_URL=https://ai-missouri.site
# Префикс пути, только для GitHub Pages (например, /missouri-site); на Vercel оставить пустым
NEXT_PUBLIC_BASE_PATH=
# false — запретить индексацию (для прототипа)
NEXT_PUBLIC_ALLOW_INDEXING=true
